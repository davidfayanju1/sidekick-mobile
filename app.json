{
  "expo": {
    "name": "sidekick",
    "slug": "sidekick",
    "version": "1.0.0",
    "scheme": "sidekick",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19262E"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sidekick to access your photos to attach reference images to a task.",
          "cameraPermission": "Allow Sidekick to use your camera to attach reference photos to a task."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adebayodev.sidekick"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.adebayodev.sidekick"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d6b3c79-557e-4eda-91b3-cbc8fac713c8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d6b3c79-557e-4eda-91b3-cbc8fac713c8"
    }
  }
}
