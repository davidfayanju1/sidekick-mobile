# Sidekick API — Environment Variables
# Copy to .env and fill in values

# APP_ENV: dev | staging | prod
APP_ENV=dev

# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sidekick_dev?sslmode=disable

# JWT secret (minimum 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: S3-compatible storage for file uploads
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=eu-west-2
# S3_BUCKET_PREFIX=sidekick-

# Optional: port override (Render sets this automatically)
# PORT=8080
